    "start:vefaas": "node server.js",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:qimen": "node --experimental-strip-types scripts/verify-qimen.mjs"
  },
  "dependencies": {
    "lunar-javascript": "^1.7.7",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}

  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:vefaas": "next build && mkdir -p .next/standalone/public .next/standalone/.next/static .next/standalone/vendor/qimen-dunjia/python-libs && cp -R public/. .next/standalone/public/ && cp -R .next/static/. .next/standalone/.next/static/ && python3 -m pip install --disable-pip-version-check --no-cache-dir --target .next/standalone/vendor/qimen-dunjia/python-libs -r vendor/qimen-dunjia/scripts/requirements.txt",
    "start": "next start -p 3000",
    "start:vefaas": "node server.js",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:qimen": "node --experimental-strip-types scripts/verify-qimen.mjs",
    "test:reading-personalization": "node --experimental-strip-types scripts/verify-ai-reading-personalization.mjs",
    "test:quality": "node --experimental-strip-types scripts/verify-reading-quality.mjs",
    "test:semantic": "node --experimental-strip-types scripts/verify-semantic-answers.mjs",
    "test:adversarial": "node --experimental-strip-types scripts/verify-adversarial-answers.mjs",
    "test:conversation": "node --experimental-strip-types scripts/verify-conversation-quality.mjs",
    "test:live-ai": "node scripts/verify-live-ai-contract.mjs",
    "test:skill": "node --experimental-strip-types scripts/verify-skill-engine.mjs",
    "test:invite-auth": "node scripts/verify-invite-auth.mjs",
    "audit:reading-repetition": "node --experimental-strip-types scripts/audit-reading-repetition.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "lunar-javascript": "^1.7.7",
    "next": "16.2.6",
